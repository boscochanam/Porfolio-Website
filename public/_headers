# Cloudflare static-asset headers (copied to dist/). Astro hashes everything in /_astro, so it never changes
# under the same name. Fonts and images keep fixed names, so they get a month and revalidate in the background.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
