---
import { caseById } from '../data/cubing';
const figs = [
  { id: 'OLL 45', label: 'OLL · edges', count: '3' },
  { id: 'OLL 27', label: 'OLL · corners', count: '7' },
  { id: 'PLL T', label: 'PLL · corners', count: '2' },
  { id: 'PLL Ua', label: 'PLL · edges', count: '4' },
];
---
<div class="prj-art" aria-hidden="true">
  {figs.map((f) => {
    const c = caseById.get(f.id);
    return (
      <div class="prj-fig">
        <p class="prj-fig-cap"><span>{f.label}</span><b>{f.count}</b></p>
        {c && <div class="prj-cube" set:html={c.svg} />}
      </div>
    );
  })}
</div>
