---
import { about, links } from '../data/site';
import MailCopy from './MailCopy.astro';
import Ruler from './Ruler.astro';
import Icon from './Icon.astro';
---
<footer class="foot-block">
  <Ruler variant="footer" />
  <div class="wrap foot-grid">
    <section id="about" aria-labelledby="about-h">
      <h2 id="about-h">About</h2>
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </section>
    <section id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">Contact</h2>
      <p class="open">{about.open}</p>
      <MailCopy />
      <ul class="clist">
        <li><span><Icon name="x" />X</span><a class="ik" href={links.x}><span>{links.xHandle}</span><Icon name="arrow" class="ext" /></a></li>
        <li><span><Icon name="youtube" />YouTube</span><a class="ik" href={links.youtube}><span>{links.youtubeLabel}</span><Icon name="arrow" class="ext" /></a></li>
        <li><span><Icon name="linkedin" />LinkedIn</span><a class="ik" href={links.linkedin}><span>{links.linkedinLabel}</span><Icon name="arrow" class="ext" /></a></li>
        <li><span><Icon name="github" />GitHub</span><a class="ik" href={links.github}><span>GitHub profile</span><Icon name="arrow" class="ext" /></a></li>
        <li><span><Icon name="file" />CV</span><a href={links.cv}>Download PDF</a></li>
      </ul>
      <p class="copyr">{about.copyright}</p>
    </section>
  </div>
</footer>
