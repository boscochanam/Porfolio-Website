---
import { site } from '../data/site';
// The same tabs on every page; on project pages they point back to the home page sections.
const home = Astro.url.pathname === '/';
const base = home ? '' : '/';
const nav = [
  ['#work', 'Work'],
  ['#gallery', 'Gallery'],
  ['#background', 'Background'],
  ['#about', 'About'],
  ['#contact', 'Contact'],
];
---
<header class="bar">
  <div class="wrap">
    <a class="brand" href={home ? '#top' : '/'}>{site.name}</a>
    <nav class="tabs" aria-label="Sections">
      {nav.map(([hash, label]) => (
        <a href={`${base}${hash}`} aria-current={!home && hash === '#gallery' ? 'true' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>
