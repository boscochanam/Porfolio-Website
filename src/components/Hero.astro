---
import { site, links } from '../data/site';
import { rich } from '../lib/rich';
import MailCopy from './MailCopy.astro';
import Icon from './Icon.astro';
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <img class="photo" src={site.headshot} alt={site.name} width="132" height="132" loading="eager" decoding="async">
    <div class="hero-text">
      <p class="label id">{site.role} · {site.location}</p>
      <h1>{site.name}</h1>
      <p class="lede">{site.lede}</p>
      <ul class="proof" aria-label="Proof">
        {site.proof.map((p) => <li set:html={rich(p)} />)}
      </ul>
      <div class="reach">
        <MailCopy />
        <span class="lk">
          <a class="ik" href={links.github}><Icon name="github" /><span>GitHub</span><Icon name="arrow" class="ext" /></a>
          <a class="ik" href={links.linkedin}><Icon name="linkedin" /><span>LinkedIn</span><Icon name="arrow" class="ext" /></a>
          <a class="ik" href={links.x}><Icon name="x" /><span>X</span><Icon name="arrow" class="ext" /></a>
          <a class="ik" href={links.youtube}><Icon name="youtube" /><span>YouTube</span><Icon name="arrow" class="ext" /></a>
          <a class="ik" href={links.cv}><Icon name="file" /><span>CV (PDF)</span></a>
        </span>
      </div>
    </div>
    <aside class="now" aria-label="Now">
      <p class="label">{site.now.label}</p>
      <ul>
        {site.now.items.map((n) => <li>{n}</li>)}
      </ul>
    </aside>
  </div>
</section>
