---
import { getCollection } from 'astro:content';
import { projectPages } from '../data/project-pages';
import Tile from './Tile.astro';
const work = (await getCollection('projects')).filter((p) => p.data.home).sort((a, b) => a.data.order - b.data.order);
const rows = [
  ...work.map((p) => ({ name: p.data.name ?? p.data.title, short: p.data.short ?? p.data.summary, icon: p.data.icon, href: '/projects/' })),
  ...projectPages.map((p) => ({ name: p.title, short: p.short, icon: 'cube', href: p.href })),
];
---
<section class="blk" id="work">
  <h2 class="blk-h label" data-ruler="Projects" data-nav="work">Projects</h2>
  <ul class="ln-list">
    {rows.map((r) => (
      <li><Tile icon={r.icon} /><a class="ln-main" href={r.href}><span class="ln-name">{r.name}</span><span class="ln-short">{r.short}</span></a></li>
    ))}
  </ul>
  <a class="blk-more" href="/projects/">All projects</a>
</section>
