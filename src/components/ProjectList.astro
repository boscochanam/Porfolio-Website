---
// Home page project rows: the content collection plus the standalone project pages.
import { getCollection } from 'astro:content';
import { projectPages } from '../data/project-pages';
import Brand from './Brand.astro';
const work = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rows = [
  ...work.map((p) => ({ title: p.data.title, line: p.data.summary, status: p.data.status ?? p.data.kind, icon: p.data.icon, href: p.data.codeUrl && p.data.codeUrl !== '#' ? p.data.codeUrl : undefined })),
  ...projectPages.map((p) => ({ title: p.title, line: p.summary, status: 'Live', icon: undefined, href: p.href })),
];
---
<section class="blk" id="work">
  <h2 class="blk-h label" data-ruler="Projects" data-nav="work">Projects</h2>
  <ul class="pl">
    {rows.map((r) => (
      <li>
        <div class="pl-top">
          <span class="pl-title"><Brand name={r.icon} />{r.href ? <a href={r.href}>{r.title}</a> : r.title}</span>
          <span class:list={['pl-status', { live: r.status === 'Live' }]}>{r.status}</span>
        </div>
        <p class="pl-line">{r.line}</p>
      </li>
    ))}
  </ul>
  <a class="blk-more" href="/projects/">All projects, with drawings and stacks</a>
</section>
