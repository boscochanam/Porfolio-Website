---
import { getCollection } from 'astro:content';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.find((p) => p.data.featured);
const rest = all.filter((p) => !p.data.featured);
---
<section class="sec" id="projects">
  <div class="wrap">
    <header class="sec-head"><h2>Projects</h2><p>What I've built, at work and on my own.</p></header>
    {featured && <FeaturedProject project={featured} />}
    <div class="cards">
      {rest.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</section>
