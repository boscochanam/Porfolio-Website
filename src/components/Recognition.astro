---
import { background as bg } from '../data/site';
import LinkRow from './LinkRow.astro';
---
<section class="blk" id="background">
  <h2 class="blk-h label" data-ruler="Research" data-nav="background">Research &amp; recognition</h2>
  <p class="tg-h">Papers</p>
  <ul class="ln-list">
    {bg.papers.map((p) => <LinkRow icon="paper" title={p.title} meta={p.meta} url={p.url} />)}
  </ul>
  <p class="tg-h">Recognition</p>
  <ul class="ln-list">
    {bg.recognition.map((r) => <LinkRow icon={r.icon} title={r.title} meta={r.meta} url={r.url} />)}
  </ul>
</section>
