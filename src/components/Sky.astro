---
// Fixed night-sky canvas behind every page. Scene and palette come from site.ts; `?scene=` and `?palette=`
// override them, and `?scenes` shows a picker (kept for the browser session) to compare them across pages.
import { sky } from '../data/site';
---
<canvas class="sky" id="sky" aria-hidden="true" data-scene={sky.scene} data-palette={sky.palette}></canvas>

<script>
  import { startSky, SCENES } from '../scripts/sky';

  // Text that sits straight on the sky; the sky dims behind each of these boxes. Keep them tight (text lines,
  // not whole sections) so the scene stays visible around them. The Now aside is a glass panel instead.
  const CALM = '.hero-text>*,.sec-head>*,.bg>div,.sheet-head>*,.sheet-sec-head>*,.note2,.sheet-toc,.sheet-toc-m,[data-sky-calm]';
  const cv = document.getElementById('sky') as HTMLCanvasElement;
  const q = new URLSearchParams(location.search);
  const store = (k: string, v?: string) => { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch { /* storage blocked */ } return null; };
  if (q.has('scenes')) store('sky-pick', '1');
  const scene = q.get('scene') || store('sky-scene') || cv.dataset.scene || 'saturn';
  const palette = q.get('palette') || store(`sky-pal-${scene}`) || cv.dataset.palette || undefined;
  const sky = startSky(cv, scene, CALM, palette);

  if (store('sky-pick')) {
    const box = document.createElement('div');
    box.className = 'sky-pick';
    box.setAttribute('role', 'group');
    box.setAttribute('aria-label', 'Sky scene and palette');
    const render = () => {
      const btn = (kind: string, k: string, label: string, on: boolean) => `<button type="button" data-${kind}="${k}" aria-pressed="${on}">${label}</button>`;
      box.innerHTML = '<span>Scene</span>' + Object.entries(SCENES).map(([k, v]) => btn('scene', k, v, k === sky.scene)).join('')
        + '<span>Palette</span>' + sky.palettes.map((k) => btn('pal', k, k, k === sky.palette)).join('');
    };
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.dataset.scene) {
        sky.set(b.dataset.scene, store(`sky-pal-${b.dataset.scene}`) || undefined);
        store('sky-scene', b.dataset.scene);
      } else if (b.dataset.pal) {
        sky.setPalette(b.dataset.pal);
        store(`sky-pal-${sky.scene}`, b.dataset.pal);
      }
      render();
    });
    document.body.append(box);
    render();
  }
</script>
