---
import { sky } from '../data/site';
---
<canvas class="sky" id="sky" aria-hidden="true" data-scene={sky.scene} data-palette={sky.palette}></canvas>

<script>
  import { startSky } from '../scripts/sky/index';

  const CALM = '.intro-meta,.intro-id,.intro-text>p,.blk-h,.tl-head,.tl-role,.ln-list li,.tg,.tg-h,.blk-more,.foot-open,.foot-bar,.sec-head>*,.sheet-head>*,.sheet-sec-head>*,.note2,.sheet-toc,.sheet-toc-m,[data-sky-calm]';
  const cv = document.getElementById('sky') as HTMLCanvasElement;
  const q = new URLSearchParams(location.search);
  const store = (k: string, v?: string) => { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch { } return null; };
  if (q.has('scenes')) store('sky-pick', '1');
  const scene = q.get('scene') || cv.dataset.scene || 'earth';
  const palette = q.get('palette') || store(`sky-pal-${scene}`) || cv.dataset.palette || undefined;
  const sky = startSky(cv, scene, CALM, palette);
  const fontCss = document.getElementById('font-css');
  if (fontCss) fontCss.media = 'all';

  if (store('sky-pick')) {
    const box = document.createElement('div');
    box.className = 'sky-pick';
    box.setAttribute('role', 'group');
    box.setAttribute('aria-label', 'Sky look');
    const render = () => {
      box.innerHTML = '<span>Look</span>'
        + sky.palettes.map((k) => `<button type="button" data-pal="${k}" aria-pressed="${k === sky.palette}">${k}</button>`).join('')
        + `<button type="button" class="sky-pick-min" data-min="1">${box.classList.contains('min') ? 'Show looks' : 'Hide'}</button>`;
    };
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.dataset.pal) {
        sky.setPalette(b.dataset.pal);
        store(`sky-pal-${sky.scene}`, b.dataset.pal);
      } else if (b.dataset.min) {
        box.classList.toggle('min');
      }
      render();
    });
    document.body.append(box);
    render();
  }
</script>
