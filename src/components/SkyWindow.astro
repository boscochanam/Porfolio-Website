---
// An empty band in the page flow. On narrow screens the sky scene puts Earth here, centred,
// so the globe and its satellites get their own space instead of sitting behind the copy. Projects keeps the
// band up to laptop widths because its full-width grid leaves no free column for the globe.
interface Props {
  variant?: 'projects';
}
const { variant } = Astro.props;
---
<div class:list={['sky-window', variant === 'projects' && 'sky-window--projects']} aria-hidden="true"></div>
