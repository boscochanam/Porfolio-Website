---
import { site, links, experience, education } from '../data/site';
import fontCss from '../styles/fonts.css?raw';
import '../styles/global.css';
import '../styles/ruler.css';
import Sky from '../components/Sky.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  noindex?: boolean;
}
const { title = site.title, description, ogType = 'website', noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);
const metaDescription = description ?? site.description;
const ogDescription = description ?? site.ogDescription;
const home = new URL('/', Astro.site).href;
const [givenName, familyName] = site.name.split(' ');
const jsonLd = Astro.url.pathname === '/' && JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.name, publisher: { '@id': `${home}#person` } },
    {
      '@type': 'Person',
      '@id': `${home}#person`,
      name: site.name,
      givenName,
      familyName,
      url: home,
      image: new URL(site.avatar, Astro.site).href,
      jobTitle: site.role,
      worksFor: { '@type': 'Organization', name: experience[0].org },
      alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
      address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressCountry: 'IN' },
      sameAs: [links.github, links.linkedin, links.x, links.youtube, links.letterboxd],
    },
  ],
});
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0d0e12">
<style is:inline id="font-css" set:html={fontCss}></style>
<script is:inline>
  document.getElementById('font-css').media = 'print';
  setTimeout(() => { const s = document.getElementById('font-css'); if (s) s.media = 'all'; }, 150);
</script>
<title>{title}</title>
<meta name="description" content={metaDescription}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={url}>}
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={site.name}>
<meta property="og:locale" content="en_IN">
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={site.ogImageAlt}>
<meta property="og:url" content={url}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:creator" content={links.xHandle}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={site.ogImageAlt}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body>
<Sky />
<slot />
</body>
</html>
