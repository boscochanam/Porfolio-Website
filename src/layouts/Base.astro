---
import { site, links } from '../data/site';
import fontCss from '../styles/fonts.css?raw';
import '../styles/global.css';
import '../styles/ruler.css';
import Sky from '../components/Sky.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}
const { title = site.title, description, ogType = 'website' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);
const metaDescription = description ?? site.description;
const ogDescription = description ?? site.ogDescription;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0d0e12">
<style is:inline id="font-css" set:html={fontCss}></style>
<script is:inline>
  // Hold the web fonts back briefly so the sky's small JS bundle wins the first round trip; Sky.astro
  // releases them as soon as its first frame is drawn, and this timer is the fallback if it cannot.
  // Text paints in the fallback either way. With JS off the style stays active, so the real fonts load.
  document.getElementById('font-css').media = 'print';
  setTimeout(() => { const s = document.getElementById('font-css'); if (s) s.media = 'all'; }, 150);
</script>
<title>{title}</title>
<meta name="description" content={metaDescription}>
<link rel="canonical" href={url}>
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content={url}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:creator" content={links.xHandle}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
<Sky />
<slot />
</body>
</html>
