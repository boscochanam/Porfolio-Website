---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Ruler from '../../components/Ruler.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';

const description = 'Selected work and project pages from Bosco Chanam: factory computer vision, edge ML and one-off tools.';
---
<Base title={`Projects — ${site.name}`} description={description}>
  <Header />
  <main>
    <Ruler />
    <section class="sec prj-page">
      <div class="wrap">
        <header class="sec-head prj-head" data-ruler="Projects">
          <h1>Projects</h1>
          <p>Selected work and project pages — from factory deployments to one-off tools.</p>
        </header>
        <ProjectsGrid />
      </div>
    </section>
  </main>
  <Footer />
</Base>
